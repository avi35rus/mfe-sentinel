{
  "name": "mfe-sentinel",
  "version": "0.1.0",
  "description": "CLI tool for Micro-Frontend contract auditing (Module Federation)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mfe-sentinel": "./bin/mfe-sentinel.js",
    "sentinel": "./bin/mfe-sentinel.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi35rus/mfe-sentinel.git"
  },
  "homepage": "https://github.com/avi35rus/mfe-sentinel#readme",
  "bugs": {
    "url": "https://github.com/avi35rus/mfe-sentinel/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mfe",
    "micro-frontend",
    "module-federation",
    "cli",
    "audit"
  ],
  "author": "Vladimir Aleksandrov <founder@sentinel-hq.io>",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "semver": "^7.7.4"
  },
  "vitest": {
    "environment": "node",
    "include": ["src/**/*.test.ts"]
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
